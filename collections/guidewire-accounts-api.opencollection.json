{
  "opencollection": "1.0.0",
  "info": {
    "name": "Guidewire ClaimCenter Accounts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.guidewire.com/oauth/authorize",
      "accessTokenUrl": "https://login.guidewire.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.guidewire.com/cc/rest/v1/accounts",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query for account name"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns customer accounts with optional search by name or account number."
        },
        {
          "info": {
            "name": "Get account details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.guidewire.com/cc/rest/v1/accounts/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the account record including all associated contacts and policy references."
        }
      ]
    }
  ],
  "bundled": true
}